# The catalogue JSON is generated from skills/ by web/build-skills.mjs (8 MB a copy; it used to be
# committed on every change and had grown to most of the repository's history). Built at the front
# of 'npm run check', at prepack, at deploy and in every workflow that reads it.
web/skills.json
web/skills-index.json
extension/skills.json
python/pm_skills/skills.json
# Generated from skills/ by scripts/build-exports.mjs: built before npm publish (prepack)
# and published to the 'exports' branch for browsing. Only the two folders Google already
# indexes (Cursor and Windsurf rules) are committed to main, so those links keep working.
exports/*
!exports/README.md
!exports/cursor/
!exports/windsurf/
# Large binaries live on the 'media' branch (served by raw URL), not on main.
docs/print/*.pdf
web/docs-assets/handbook.pdf
web/docs-assets/PM-Skills-Guide.pdf
web/docs-assets/cheatsheet.pdf
docs/readme-assets/video/*.mp4
# tools-pkg generated output: built by scripts/build-tools-exports.mjs at prepack.
tools-pkg/openai-tools.json
tools-pkg/tools.mjs
tools-pkg/index.json
tools-pkg/instructions/

# PM-8B pipeline outputs (rebuilt by training/*.mjs; teacher rows carry model outputs)
training/teacher.jsonl
training/teacher-rejected.jsonl
training/pm-8b-train.jsonl
training/pm-8b-heldout-tasks.json
training/pm-8b-results.json
training/out/

# The jobs-exam key unblinds graders: published only after grading closes.
skillbench/jobs-exam/.key.json

# Eval outputs saved with --save-outputs (for diagnosis; not published)
evals/outputs/

# Fake-apps sandbox action log (integrations/fake-apps-mcp)
integrations/fake-apps-mcp/sandbox-actions.log

# One ZIP per skill for claude.ai upload (scripts/build-skill-zips.mjs, built at deploy)
web/skill-zip/

# /.well-known/agent-skills.json (scripts/build-well-known.mjs, built at deploy)
web/.well-known/

# Local secrets (see .env.example)
.env
.env.*
!.env.example

# /schemas/ copied to web/schemas/ at deploy (scripts/check-skill-schemas.mjs validates the source)
web/schemas/

# Per-skill git history for the CLI changelog and doctor (scripts/build-skill-changelog.mjs, built at deploy and prepack)
web/skill-changelog.json

# Atom feed of skill changes (scripts/build-skill-changes.mjs, built at deploy)
web/changes.xml

# Year-in-review pages (scripts/build-year-in-review.mjs, built at deploy from git history and the data files)
web/report/
