# Copy to .env and fill in only what you need. Every script runs without any of
# these set; each one unlocks an optional route. Never commit a real .env.

# --- Spend gate -------------------------------------------------------------
# Scripts that would call a paid API refuse to run unless this is "true".
# ALLOW_API_SPEND=true
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# --- Free local models (Ollama, LM Studio, any OpenAI-compatible server) -----
# Used by scripts/local-eval.mjs, the judge, and the keyless playground routes.
# LOCAL_BASE_URL=http://localhost:11434/v1
# PM_SKILLS_LOCAL_MODEL=llama3.1
# PM_SKILLS_LOCAL_KEY=
# OPENAI_BASE_URL=

# --- GitHub -----------------------------------------------------------------
# Raises the API rate limit for build-community, star-history and the mirrors.
# GITHUB_TOKEN=

# --- Website analytics (optional, privacy-friendly) -------------------------
# GOATCOUNTER_SITE=
# GOATCOUNTER_TOKEN=

# --- Screenshots and share cards --------------------------------------------
# Only needed when regenerating images. Playwright finds Chromium itself if unset.
# CHROMIUM_PATH=
# PLAYWRIGHT_PATH=

# --- Mirrors and search engines (maintainer only) ---------------------------
# GITEE_TOKEN=
# BAIDU_PUSH_TOKEN=
# INDEXNOW_KEY=
